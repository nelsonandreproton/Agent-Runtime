# Copy to .env (or export directly) before running `agent-runtime`.

# Directory containing the agent .md files (Claude Code / Cowork subagent format).
AGENT_RUNTIME_AGENTS_DIR=agents

# By default every agent .md found in AGENT_RUNTIME_AGENTS_DIR is served, each
# under its own /agents/<name>/ sub-path. Set this (comma-separated frontmatter
# `name`s) to expose only a subset. Leave unset to serve all of them.
#AGENT_RUNTIME_AGENT_NAMES=code-reviewer,security-reviewer

# llama-server (llama.cpp) OpenAI-compatible endpoint.
AGENT_RUNTIME_LLAMA_BASE_URL=http://127.0.0.1:8080
AGENT_RUNTIME_LLAMA_MODEL=local-model

# JSON file describing which MCP servers to connect and how their tools map
# onto Claude Code tool names. See config/mcp_servers.example.json.
AGENT_RUNTIME_MCP_CONFIG=config/mcp_servers.json

# The one directory any filesystem-capable MCP server may be scoped to. Any
# {WORKING_DIR} placeholder in mcp_servers.json's args/env is substituted with
# this path at startup — deliberately separate from this runtime's own source
# and from config/ (.env, mcp_servers.json), so an agent's Read/Write/Glob can
# never reach those secrets no matter what an agent or a misconfigured MCP
# server tries. Created automatically if it doesn't exist. To let an agent
# read this repo's own code (e.g. the code-reviewer/security-reviewer demo
# agents), copy or symlink the source you want reviewed into this directory —
# never point AGENT_RUNTIME_WORKING_DIR at the repo root itself.
AGENT_RUNTIME_WORKING_DIR=data

# SQLite file that A2A task state is persisted to, so an in-flight task
# survives a gateway restart instead of vanishing (the a2a-sdk's default
# InMemoryTaskStore loses everything on process exit). Created automatically
# if it doesn't exist. Set to an empty value to disable persistence and fall
# back to InMemoryTaskStore (e.g. for a throwaway local run). This file holds
# full task content (user messages, agent responses, artifacts) — the same
# category of sensitive data as AGENT_RUNTIME_LOG_LEVEL=DEBUG logs. Keep it
# untracked (already gitignored via state/) and access-controlled like
# config/.env.
AGENT_RUNTIME_TASK_STORE_PATH=state/tasks.db

# A2A gateway bind address and the base public URL this process is reachable
# at. Each agent is then advertised at <PUBLIC_URL>/agents/<name>/ — that
# per-agent URL is what an external caller (e.g. OutSystems ODC) should use.
AGENT_RUNTIME_HOST=0.0.0.0
AGENT_RUNTIME_PORT=9000
AGENT_RUNTIME_PUBLIC_URL=http://localhost:9000/

# Per-request timeout (seconds) for calls to llama-server.
AGENT_RUNTIME_TIMEOUT=120

# Per-call timeout (seconds) for MCP tool calls (e.g. Read/Write/Glob). A
# hung or slow MCP server subprocess would otherwise stall the request
# indefinitely — the connection pool is shared across every agent, so an
# unbounded wait here would degrade the whole gateway, not just one caller.
AGENT_RUNTIME_MCP_TIMEOUT=60

# Logging verbosity. INFO (default) logs request/response sizes, tool names,
# and outcomes, but never raw content. Set to DEBUG to additionally log full
# request/response bodies and tool call arguments/results — this can include
# sensitive data (file contents an agent read, CRM records, transcripts) and
# should only be used for local debugging, never left on where logs leave this
# machine (shipped to a log aggregator, mounted into another container, etc).
#AGENT_RUNTIME_LOG_LEVEL=DEBUG
